# ============================
# AutoApply Hub — Environment Variables
# ============================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# ----- Server -----
PORT=3001
NODE_ENV=development

# ----- PostgreSQL (Railway) -----
# Use a dedicated schema to isolate from other projects in the same DB
DATABASE_URL=postgresql://postgres:CHANGE_ME@host:port/railway?search_path=auto_apply
DB_SCHEMA=auto_apply

# Liquibase (JDBC format)
DB_URL=jdbc:postgresql://host:port/railway
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ----- OpenAI (optional — for AI-assisted proposal generation) -----
OPENAI_API_KEY=sk-your-key-here

# ----- Scraper -----
SCRAPER_USER_AGENT=AutoApplyHub/0.1 (+contact@yourdomain.com)
SCRAPER_RATE_LIMIT_RPS=1

# ----- Application behaviour -----
# Keep true unless you explicitly want to submit real applications
DEFAULT_SIMULATE=true

# ----- JWT (future auth layer) -----
JWT_SECRET=change-this-secret-in-production-use-32-chars-minimum

# ----- Workers -----
# Cron expression: every 30 minutes
INGEST_CRON=*/30 * * * *
